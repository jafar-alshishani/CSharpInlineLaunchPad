<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>14</LangVersion>

    <VSSDKBuildToolsAutoSetup>true</VSSDKBuildToolsAutoSetup>
    <GeneratePkgDefFile>true</GeneratePkgDefFile>
    <AssemblyName>CSharpInlineLaunchPad</AssemblyName>
    <RootNamespace>CSharpInlineLaunchPad</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Resources\icon.png" />
    <None Remove="Resources\RunCSharp.svg" />
    <None Remove="Icons.imagemanifest" />
    <None Remove="Resources\square-terminal.png" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Resources\icon.png" />
    <Content Include="Resources\square-terminal.png" />
    <ImageManifest Include="Icons.imagemanifest">
      <IncludeInVSIX>true</IncludeInVSIX>
    </ImageManifest>
  </ItemGroup>

  <ItemGroup>
    <ProjectCapability Include="CreateVsixContainer" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Design" />
  </ItemGroup>

  <ItemGroup>
    <VSCTCompile Include="VSCommandTable.vsct">
      <ResourceName>Menus.ctmenu</ResourceName>
    </VSCTCompile>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.VisualStudio.SDK" Version="17.14.40265" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.VSSDK.BuildTools" Version="18.9.820" />
  </ItemGroup>

</Project>